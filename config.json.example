{
  "_comment": "Copy this file to config.json and fill in your values.",

  "token": "YOUR_DISCORD_BOT_TOKEN",
  "command_prefix": "!",

  "_channel_id_help": "Enable Developer Mode in Discord (Settings > Advanced > Developer Mode), then right-click any channel and choose 'Copy Channel ID'.",
  "channel_id": 123456789012345678,

  "server_name": "My Minecraft Server",

  "minecraft_log": "/path/to/minecraft/logs/latest.log",

  "bridge_method": "rcon",

  "rcon": {
    "host": "localhost",
    "port": 25575,
    "password": "your_rcon_password"
  },

  "tmux": {
    "session": "minecraft"
  }
}
